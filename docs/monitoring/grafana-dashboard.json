{
  "title": "Webhook Bridge Overview",
  "uid": "webhook-bridge-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["webhook", "telegram", "operations"],
  "panels": [
    {
      "type": "stat",
      "title": "Webhook Requests / min",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(webhook_requests_total[1m])) * 60",
          "refId": "A",
          "legendFormat": "req/min"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Delivery Failures / 5m",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(webhook_requests_total{status=\"delivery_failed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Telegram Failed Sends / 5m",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(telegram_messages_total{status=\"failed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Service Up",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "max(up{job=\"webhook-bridge\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Webhook Status Rate (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(webhook_requests_total[5m])) by (status)",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Webhook Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(webhook_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events by Source",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum(rate(webhook_requests_total[5m])) by (source)",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Telegram Send Status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum(rate(telegram_messages_total[5m])) by (status)",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
