# Minimal required configuration (single-chat + single-key admin mode)
# Copy to .env and replace placeholder values.

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
GITHUB_WEBHOOK_SECRET=replace_with_random_secret
GENERIC_WEBHOOK_TOKEN=replace_with_random_token
# Single key works directly in ADMIN_API_KEYS (equivalent to legacy ADMIN_API_KEY)
ADMIN_API_KEYS=replace_with_admin_api_key
