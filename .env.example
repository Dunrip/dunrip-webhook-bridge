# Required settings
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
GITHUB_WEBHOOK_SECRET=your-github-secret
GENERIC_WEBHOOK_TOKEN=your-generic-token
# Admin auth (supports scoped CSV OR a single bare key)
ADMIN_API_KEYS=read-key:read,replay-key:replay,admin-key:admin
# Example single-key mode: ADMIN_API_KEYS=your-admin-api-key
ADMIN_API_KEYS_ACTIVE=
ADMIN_API_KEYS_PREVIOUS=
ADMIN_KEY_ROTATION_GRACE_SECONDS=604800
ADMIN_KEY_ROTATION_STARTED_AT=
# Legacy fallback
ADMIN_API_KEY=your-admin-api-key

# Optional settings (defaults shown)
LOG_LEVEL=INFO

# Security limits
MAX_BODY_SIZE=1048576        # Max webhook payload size in bytes (default: 1MB)
IDEMPOTENCY_TTL=3600         # Dedupe window in seconds (default: 1 hour)
FAILED_DELIVERY_TTL=604800   # Keep failed deliveries for 7 days

# Telegram retry configuration
TELEGRAM_RETRIES=2           # Number of retries for Telegram API calls (default: 2)

# Circuit breaker configuration
CIRCUIT_BREAKER_THRESHOLD=5  # Failures before opening circuit (default: 5)
CIRCUIT_BREAKER_TIMEOUT=60   # Seconds before half-open (default: 60)

# Storage backend
STORAGE_BACKEND=memory       # memory or redis
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=webhook_bridge

# Rate limiting
RATE_LIMIT_BACKEND=memory        # memory or redis
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=20

# WebSocket admin stream hardening
WS_CONNECTS_PER_MINUTE=10
WS_MAX_CONNECTIONS_PER_IP=3

# Replay hardening
REPLAY_COOLDOWN_SECONDS=30
MAX_REPLAY_ATTEMPTS=10

# Trusted proxies for X-Forwarded-For handling (optional)
# Leave empty to ignore X-Forwarded-For and use direct client IP only.
# Supports comma-separated IPs and/or CIDRs, e.g. "10.0.0.10,10.0.0.0/24"
TRUSTED_PROXIES=

# Admin/replay IP allowlist (optional)
# Empty = disabled (no IP allowlist check). When set, /deliveries* requests are fail-closed.
# Supports comma-separated IPs/CIDRs, e.g. "203.0.113.10,203.0.113.0/24"
ADMIN_IP_ALLOWLIST=

# WebSocket /stream/logs IP allowlist (optional)
# Empty = fallback to ADMIN_IP_ALLOWLIST. When effective allowlist is set, websocket is fail-closed.
WS_IP_ALLOWLIST=

# Optional: Grafana admin password (for docker-compose monitoring profile)
# GRAFANA_PASSWORD=admin
